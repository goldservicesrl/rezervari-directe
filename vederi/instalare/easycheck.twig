{% extends 'instalare/cadru.twig' %}
{% block continut %}
<h1>{{ t('instalare.pas.easycheck') }}</h1>
{#- întrebarea de la început; fără cheie, datele proprietății și prima cameră, completate aici. -#}
{% set spre_local %}
<form method="post" action="{{ actiune }}">{% include 'instalare/formular.twig' %}<input type="hidden" name="actiune" value="alege"><input type="hidden" name="mod" value="local">
<p><button type="submit" class="pa-buton-secundar" aria-describedby="pi-local-ajutor">{{ t('instalare.local.local') }}</button></p><p class="pa-ajutor" id="pi-local-ajutor">{{ t('instalare.local.local_ajutor') }}</p></form>
{% endset %}
{% if mod_site == 'local' %}
<p>{{ t('instalare.local.text') }}</p>
{% set v = local.v %}{% set e = local.erori %}
<form class="pa-formular" method="post" action="{{ actiune }}">{% include 'instalare/formular.twig' %}<input type="hidden" name="actiune" value="local">
<fieldset><legend>{{ t('admin.local.prop.despre') }}</legend>
{% include 'admin/_camp_local.twig' with {id: 'pi-l-nume', nume: 'nume', eticheta: 'admin.local.prop.nume', valoare: v.nume, eroare: e.nume ?? '', max: 191, cerut: true} only %}
<p><label for="pi-l-tip">{{ t('admin.local.prop.tip') }}</label><select id="pi-l-tip" name="tip">{% for x in local.tipuri %}<option value="{{ x }}"{% if v.tip == x %} selected{% endif %}>{{ t('admin.local.tip.' ~ x) }}</option>{% endfor %}</select></p>
{% include 'admin/_camp_local.twig' with {id: 'pi-l-dro', nume: 'descriere_ro', eticheta: 'admin.local.prop.descriere_ro', valoare: v.descriere_ro, eroare: '', tip: 'textarea', max: 4000, lang: 'ro', randuri: 3} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-den', nume: 'descriere_en', eticheta: 'admin.local.prop.descriere_en', valoare: v.descriere_en, eroare: '', tip: 'textarea', max: 4000, lang: 'en', randuri: 3} only %}
</fieldset>
<fieldset><legend>{{ t('admin.local.prop.adresa') }}</legend>
{% include 'admin/_camp_local.twig' with {id: 'pi-l-str', nume: 'strada', eticheta: 'admin.local.prop.strada', valoare: v.strada, eroare: '', max: 191} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-loc', nume: 'localitate', eticheta: 'admin.local.prop.localitate', valoare: v.localitate, eroare: e.localitate ?? '', max: 191, cerut: true} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-jud', nume: 'judet', eticheta: 'admin.local.prop.judet', valoare: v.judet, eroare: '', max: 191} only %}
<input type="hidden" name="lat" value="{{ v.lat }}"><input type="hidden" name="lng" value="{{ v.lng }}">
<p class="pa-ajutor">{{ t('instalare.local.harta') }}</p>
</fieldset>
<fieldset><legend>{{ t('admin.local.prop.ore') }}</legend>
{% include 'admin/_camp_local.twig' with {id: 'pi-l-ci', nume: 'checkin_de_la', eticheta: 'admin.local.prop.checkin_de_la', valoare: v.checkin_de_la, eroare: e.checkin_de_la ?? '', tip: 'time', clasa: 'pa-scurt', cerut: true} only %}
<input type="hidden" name="checkin_pana_la" value="{{ v.checkin_pana_la }}">
{% include 'admin/_camp_local.twig' with {id: 'pi-l-co', nume: 'plecare_pana_la', eticheta: 'admin.local.prop.plecare_pana_la', valoare: v.plecare_pana_la, eroare: e.plecare_pana_la ?? '', tip: 'time', clasa: 'pa-scurt', cerut: true} only %}
</fieldset>
<fieldset><legend>{{ t('admin.local.prop.reguli') }}</legend>
{% for x in local.reguli_casa %}<p><label for="pi-l-r-{{ x }}">{{ t('admin.local.regula.' ~ x) }}</label><select id="pi-l-r-{{ x }}" name="regula_{{ x }}">
<option value=""{% if v['regula_' ~ x] == '' %} selected{% endif %}>{{ t('admin.local.regula.gol') }}</option>
<option value="da"{% if v['regula_' ~ x] == 'da' %} selected{% endif %}>{{ t('admin.local.regula.permis') }}</option>
<option value="nu"{% if v['regula_' ~ x] == 'nu' %} selected{% endif %}>{{ t('admin.local.regula.interzis') }}</option></select></p>
{% endfor %}<input type="hidden" name="animale_max" value="{{ v.animale_max }}">
</fieldset>
<fieldset><legend>{{ t('admin.local.prop.contact') }}</legend>
{% include 'admin/_camp_local.twig' with {id: 'pi-l-em', nume: 'email', eticheta: 'admin.local.prop.email', valoare: v.email, eroare: e.email ?? '', tip: 'email', cerut: true, ajutor: 'admin.local.prop.email_ajutor'} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-tel', nume: 'telefon', eticheta: 'admin.local.prop.telefon', valoare: v.telefon, eroare: '', tip: 'tel', max: 40} only %}
</fieldset>
<fieldset><legend>{{ t('instalare.local.camera') }}</legend>
<p class="pa-ajutor">{{ t('instalare.local.camera_ajutor') }}</p>
{% include 'admin/_camp_local.twig' with {id: 'pi-l-ct', nume: 'camera_titlu', eticheta: 'admin.local.cam.nume', valoare: v.camera_titlu, eroare: e.camera_titlu ?? '', max: 120, cerut: true} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-cu', nume: 'camera_unitati', eticheta: 'admin.local.cam.unitati', valoare: v.camera_unitati, eroare: e.camera_unitati ?? '', clasa: 'pa-scurt', mod: 'numeric', cerut: true, ajutor: 'admin.local.cam.unitati_ajutor'} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-co2', nume: 'camera_oaspeti_max', eticheta: 'admin.local.cam.oaspeti', valoare: v.camera_oaspeti_max, eroare: e.camera_oaspeti_max ?? '', clasa: 'pa-scurt', mod: 'numeric', cerut: true} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-cpn', nume: 'camera_pret_noapte', eticheta: 'admin.local.cam.pret_noapte', valoare: v.camera_pret_noapte, eroare: e.camera_pret_noapte ?? '', clasa: 'pa-scurt', mod: 'numeric', cerut: true, ajutor: 'admin.local.cam.pret_ajutor'} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-cpw', nume: 'camera_pret_weekend', eticheta: 'admin.local.cam.pret_weekend', valoare: v.camera_pret_weekend, eroare: e.camera_pret_weekend ?? '', clasa: 'pa-scurt', mod: 'numeric', ajutor: 'admin.local.cam.pret_weekend_ajutor'} only %}
</fieldset>
<fieldset><legend>{{ t('admin.local.reg.titlu') }}</legend>
<p class="pa-ajutor">{{ t('admin.local.reg.explicatie') }}</p>
{% include 'admin/_camp_local.twig' with {id: 'pi-l-min', nume: 'sejur_minim', eticheta: 'admin.local.reg.sejur_minim', valoare: v.sejur_minim, eroare: e.sejur_minim ?? '', clasa: 'pa-scurt', mod: 'numeric', cerut: true} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-av', nume: 'avans_procent', eticheta: 'admin.local.reg.avans', valoare: v.avans_procent, eroare: e.avans_procent ?? '', clasa: 'pa-scurt', mod: 'numeric', cerut: true, ajutor: 'admin.local.reg.avans_ajutor'} only %}
{% include 'admin/_camp_local.twig' with {id: 'pi-l-an', nume: 'anulare_zile', eticheta: 'admin.local.reg.anulare', valoare: v.anulare_zile, eroare: e.anulare_zile ?? '', clasa: 'pa-scurt', mod: 'numeric', cerut: true, ajutor: 'admin.local.reg.anulare_ajutor'} only %}
</fieldset>
<p>{{ t('instalare.local.dupa') }}</p>
<p><button type="submit" class="pa-buton">{{ t('instalare.continuati') }}</button></p></form>
<details class="pa-alta-cheie"><summary>{{ t('instalare.local.schimba_raspunsul') }}</summary>
<form method="post" action="{{ actiune }}">{% include 'instalare/formular.twig' %}<input type="hidden" name="actiune" value="alege"><input type="hidden" name="mod" value="easycheck">
<p>{{ t('instalare.local.da_ajutor') }}</p><p><button type="submit" class="pa-buton-secundar">{{ t('instalare.local.da') }}</button></p></form></details>
{% else %}
{% set r = ec.rezumat ?? null %}
{% if not r %}<section class="pa-card" aria-labelledby="pi-intrebare"><h2 id="pi-intrebare">{{ t('instalare.local.intrebare') }}</h2>
<p>{{ t('instalare.local.da_ajutor') }}</p>{{ spre_local }}</section>{% endif %}
{% if r %}
<p>{{ t('instalare.ec.legat', {nume: r.nume}) }}</p>
<p>{{ r.mod == 'proba' ? t('instalare.ec.mod_proba') : t('instalare.ec.mod_live') }}</p>
<p>{{ t('instalare.ec.sursa_' ~ r.sursa) }}</p>
{% if r.scop != 'rezervari' %}
<div class="pa-eroare" role="alert"><p>{{ t('conexiuni.ec.scop_citire') }}</p><p>{{ t('instalare.ec.cheie_noua') }}</p></div>
{% else %}
{% if ec.anunturi %}<p>{{ ec.anunturi.primit ? t('conexiuni.ec.anunturi_primite') : t('conexiuni.ec.anunturi_neprimite', {adresa: adresa_anunt}) }}</p>{% endif %}
<h2>{{ t('instalare.ec.sincronizare') }}</h2>
<p><label for="pi-progres">{{ t('instalare.ec.progres', {facute: progres.facute, total: progres.total}) }}</label>
<progress id="pi-progres" max="{{ progres.total }}" value="{{ progres.facute }}">{{ progres.facute }}/{{ progres.total }}</progress></p>
{% if in_lucru and not refresh %}<p><a class="pa-buton-secundar" href="{{ actiune }}{{ '?' in actiune ? '&' : '?' }}pas={{ pas }}&amp;sincronizare=1">{{ t('instalare.ec.porniti') }}</a></p>{% endif %}
{% if ec.erori %}
<p class="pa-eroare">{{ t('instalare.ec.erori', {resurse: necitite|join(', ')}) }}</p>
<form method="post" action="{{ actiune }}">{% include 'instalare/formular.twig' %}<input type="hidden" name="actiune" value="reia"><button type="submit" class="pa-buton-secundar">{{ t('instalare.ec.reia') }}</button></form>
{% endif %}
{% if gata %}<p>{{ t('instalare.ec.poze') }}</p>
<form method="post" action="{{ actiune }}">{% include 'instalare/formular.twig' %}<input type="hidden" name="actiune" value="continua"><button type="submit" class="pa-buton">{{ t('instalare.continuati') }}</button></form>{% endif %}
{% endif %}
{% endif %}
{% set formular_cheie %}
<form class="pa-formular" method="post" action="{{ actiune }}">
{% include 'instalare/formular.twig' %}<input type="hidden" name="actiune" value="cheie">
<p><label for="pi-cheie">{{ t('instalare.ec.cheie') }}</label><input id="pi-cheie" name="cheie" type="password" autocomplete="off" spellcheck="false" required></p>
<p><button type="submit" class="pa-buton{% if r %}-secundar{% endif %}">{{ t('instalare.ec.buton') }}</button></p>
</form>
{% endset %}
{% if r and r.scop == 'rezervari' %}
{# După legarea reușită, câmpul cheii stă ascuns: fără JavaScript, cu <details>; o eroare a cheii noi îl lasă deschis. #}
<details class="pa-alta-cheie"{% if eroare and eroare != 'instalare.ec.eroare_incomplet' %} open{% endif %}><summary>{{ t('instalare.ec.alta_cheie') }}</summary>
<p>{{ t('instalare.ec.alta_cheie_text') }}</p>
{{ formular_cheie }}
</details>
{% else %}
{% if not r %}
<p>{{ t('instalare.ec.text') }}</p>
<p>{{ t('instalare.ec.proba_intai') }}</p>
{% endif %}
{{ formular_cheie }}
{% endif %}
{% endif %}
{% endblock %}
