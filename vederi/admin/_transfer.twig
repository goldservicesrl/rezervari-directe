{#- Contul plății prin transfer bancar, doar câmpurile: titularul, IBAN-ul, banca, SWIFT-ul, termenul de plată și
    zilele dinaintea sosirii, în stilul formularelor panoului (eticheta, câmpul, ajutorul, eroarea lângă câmp). Pagina
    gazdă le pune sub bifa „Prin transfer bancar”, în formularul metodelor de plată: panoul la Metodele de plată
    (POST /admin/plati), instalatorul la pasul plăților. Câmpurile sunt fără atributul required: cât bifa lipsește, stau
    ascunse și rămân neatinse. Datele vin din AdminTransfer::date(); numele câmpurilor au prefixul transfer_. -#}
<p>{{ t('admin.transfer.text') }}</p>
<input type="hidden" name="actiune_transfer" value="1">
<p><label for="{{ tr.id }}-titular">{{ t('admin.transfer.titular') }}</label><span class="pa-ajutor" id="{{ tr.id }}-titular-ajutor">{{ t('admin.transfer.titular_ajutor') }}</span><input id="{{ tr.id }}-titular" name="transfer_titular" type="text" maxlength="120" value="{{ tr.valori.titular }}" autocomplete="off" aria-describedby="{{ tr.id }}-titular-ajutor{% if tr.erori.titular is defined %} {{ tr.id }}-titular-eroare{% endif %}"{% if tr.erori.titular is defined %} aria-invalid="true"{% endif %}>
{% if tr.erori.titular is defined %}<span class="pa-eroare-camp" id="{{ tr.id }}-titular-eroare">{{ tr.erori.titular }}</span>{% endif %}</p>
<p><label for="{{ tr.id }}-iban">{{ t('admin.transfer.iban') }}</label><span class="pa-ajutor" id="{{ tr.id }}-iban-ajutor">{{ t('admin.transfer.iban_ajutor') }}</span><input id="{{ tr.id }}-iban" name="transfer_iban" type="text" maxlength="60" value="{{ tr.valori.iban }}" autocomplete="off" spellcheck="false" aria-describedby="{{ tr.id }}-iban-ajutor{% if tr.erori.iban is defined %} {{ tr.id }}-iban-eroare{% endif %}"{% if tr.erori.iban is defined %} aria-invalid="true"{% endif %}>
{% if tr.erori.iban is defined %}<span class="pa-eroare-camp" id="{{ tr.id }}-iban-eroare">{{ tr.erori.iban }}</span>{% endif %}</p>
<p><label for="{{ tr.id }}-banca">{{ t('admin.transfer.banca') }}</label><span class="pa-ajutor" id="{{ tr.id }}-banca-ajutor">{{ t('admin.transfer.banca_ajutor') }}</span><input id="{{ tr.id }}-banca" name="transfer_banca" type="text" maxlength="120" value="{{ tr.valori.banca }}" autocomplete="off" aria-describedby="{{ tr.id }}-banca-ajutor"></p>
<p><label for="{{ tr.id }}-swift">{{ t('admin.transfer.swift') }}</label><span class="pa-ajutor" id="{{ tr.id }}-swift-ajutor">{{ t('admin.transfer.swift_ajutor') }}</span><input id="{{ tr.id }}-swift" name="transfer_swift" type="text" maxlength="11" value="{{ tr.valori.swift }}" autocomplete="off" spellcheck="false" aria-describedby="{{ tr.id }}-swift-ajutor{% if tr.erori.swift is defined %} {{ tr.id }}-swift-eroare{% endif %}"{% if tr.erori.swift is defined %} aria-invalid="true"{% endif %}>
{% if tr.erori.swift is defined %}<span class="pa-eroare-camp" id="{{ tr.id }}-swift-eroare">{{ tr.erori.swift }}</span>{% endif %}</p>
<p><label for="{{ tr.id }}-termen_ore">{{ t('admin.transfer.termen_ore') }}</label><span class="pa-ajutor" id="{{ tr.id }}-termen-ajutor">{{ t('admin.transfer.termen_ore_ajutor') }}</span><input id="{{ tr.id }}-termen_ore" name="transfer_termen_ore" type="number" inputmode="numeric" min="{{ tr.limite.termen[0] }}" max="{{ tr.limite.termen[1] }}" value="{{ tr.valori.termen_ore }}" aria-describedby="{{ tr.id }}-termen-ajutor{% if tr.erori.termen_ore is defined %} {{ tr.id }}-termen-eroare{% endif %}"{% if tr.erori.termen_ore is defined %} aria-invalid="true"{% endif %}>
{% if tr.erori.termen_ore is defined %}<span class="pa-eroare-camp" id="{{ tr.id }}-termen-eroare">{{ tr.erori.termen_ore }}</span>{% endif %}</p>
<p><label for="{{ tr.id }}-zile_inainte">{{ t('admin.transfer.zile_inainte') }}</label><span class="pa-ajutor" id="{{ tr.id }}-zile-ajutor">{{ t('admin.transfer.zile_inainte_ajutor') }}</span><input id="{{ tr.id }}-zile_inainte" name="transfer_zile_inainte" type="number" inputmode="numeric" min="{{ tr.limite.zile[0] }}" max="{{ tr.limite.zile[1] }}" value="{{ tr.valori.zile_inainte }}" aria-describedby="{{ tr.id }}-zile-ajutor{% if tr.erori.zile_inainte is defined %} {{ tr.id }}-zile-eroare{% endif %}"{% if tr.erori.zile_inainte is defined %} aria-invalid="true"{% endif %}>
{% if tr.erori.zile_inainte is defined %}<span class="pa-eroare-camp" id="{{ tr.id }}-zile-eroare">{{ tr.erori.zile_inainte }}</span>{% endif %}</p>
<p class="pa-ajutor">{{ t('admin.transfer.confirmare_ec') }} <a href="{{ tr.ec_url }}" rel="noopener">{{ t('admin.transfer.ec_link') }}</a></p>
