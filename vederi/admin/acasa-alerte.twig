{#- Acasă, blocul alertelor: mesajul paginii, alertele de rezolvat și notele de știut, cu butonul fiecăreia. -#}
{% extends 'admin/baza.twig' %}
{% block continut %}
<h1>{{ t('admin.acasa.titlu') }}</h1>
{% include 'admin/_stare.twig' %}
{#- în modurile E și P, hotărârile despre rezervări, bani și mesaje stau în EasyCheck. -#}
{% if ec_acasa|default(null) %}<section class="pa-info" aria-labelledby="pa-acasa-ec"><h2 id="pa-acasa-ec" class="pa-ascuns">{{ t('admin.acasa.ec_deschide') }}</h2>
<p>{{ t('admin.acasa.ec_rand') }}</p>
<p><a class="pa-buton-secundar" href="{{ ec_acasa.url }}" rel="noopener">{{ t('admin.acasa.ec_deschide') }}</a></p></section>{% endif %}
{% if alerte_grave %}<section class="pa-avertizare" aria-labelledby="pa-alerte-titlu"><h2 id="pa-alerte-titlu">{{ t('admin.acasa.de_rezolvat') }}</h2>
<ul>{% for a in alerte_grave %}<li>{% include 'admin/_alerta.twig' with {a: a, id: 'pa-alerta-' ~ loop.index, inapoi: 'acasa'} %}</li>{% endfor %}</ul></section>{% endif %}
{% if alerte_usoare %}<section class="pa-info" aria-labelledby="pa-info-titlu"><h2 id="pa-info-titlu">{{ t('admin.acasa.de_stiut') }}</h2>
<ul>{% for a in alerte_usoare %}<li>{% include 'admin/_alerta.twig' with {a: a, id: 'pa-nota-' ~ loop.index, inapoi: 'acasa'} %}</li>{% endfor %}</ul></section>{% endif %}
{% if versiune_noua %}{% include 'admin/_versiune_noua.twig' with {v: versiune_noua} %}{% endif %}
{% if in_easycheck %}<p class="pa-ajutor">{{ t('admin.alerte.in_easycheck') }}</p>{% endif %}
{% endblock %}
