{#- „Abonații la oferte”: lista (din EasyCheck, cu cheia; altfel de pe site), oferta (previzualizarea, proba, trimiterea), jurnalul trimiterilor, exportul. -#}
{% extends 'admin/baza.twig' %}
{% block continut %}
<h1>{{ t('admin.abonati.titlu') }}</h1>
{% include 'admin/_stare.twig' %}
<p>{{ t('admin.abonati.explicatie', {n: numar}) }}</p>
{% if easycheck %}
<p class="pa-nota" data-abonati-easycheck>{{ t('admin.abonati.easycheck') }} <a href="{{ url.easycheck }}" rel="noopener">{{ t('admin.abonati.easycheck_link') }}</a></p>
{% if de_urcat %}<p class="pa-info" data-abonati-de-urcat>{{ t('admin.abonati.de_urcat', {n: de_urcat}) }}</p>{% endif %}
{% if eroare_ec %}<p class="pa-avertizare" role="alert" data-abonati-eroare-ec>{{ ec_la ? t('admin.abonati.easycheck_eroare_cache', {cand: ec_la}) : t('admin.abonati.easycheck_eroare') }}</p>{% endif %}
{% endif %}

<h2 id="pa-ab-lista">{{ t('admin.abonati.lista_titlu') }}</h2>
{% if abonati %}
<div class="pa-tabel"><table>
<thead><tr><th scope="col">{{ t('admin.abonati.col.nume') }}</th><th scope="col">{{ t('admin.abonati.col.email') }}</th><th scope="col">{{ t('admin.abonati.col.limba') }}</th><th scope="col">{{ t('admin.abonati.col.sursa') }}</th><th scope="col">{{ t('admin.abonati.col.acord') }}</th><th scope="col"><span class="pa-ascuns">{{ t('admin.abonati.col.actiuni') }}</span></th></tr></thead>
<tbody>{% for a in abonati %}<tr data-abonat><th scope="row" data-eticheta="{{ t('admin.abonati.col.nume') }}">{{ a.nume ?: '-' }}</th><td data-eticheta="{{ t('admin.abonati.col.email') }}">{{ a.email }}</td><td data-eticheta="{{ t('admin.abonati.col.limba') }}">{{ a.limba }}</td><td data-eticheta="{{ t('admin.abonati.col.sursa') }}">{{ a.sursa }}</td><td data-eticheta="{{ t('admin.abonati.col.acord') }}">{{ a.acord_la }}</td>
<td class="pa-celula-actiuni"><form method="post" action="{{ url.baza }}dezaboneaza"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="email" value="{{ a.email }}"><button type="submit" class="pa-buton-secundar">{{ t('admin.abonati.scoate') }}<span class="pa-ascuns"> {{ a.email }}</span></button></form></td></tr>{% endfor %}</tbody>
</table></div>
<form method="post" action="{{ url.baza }}export"><input type="hidden" name="_csrf" value="{{ csrf }}">
<p class="pa-ajutor">{{ t('admin.abonati.export_ajutor') }}</p>
{% if eroare_la == 'export' %}<p class="pa-eroare-camp" role="alert">{{ t('admin.reauth.eroare') }}</p>{% endif %}
{% include 'admin/_reauth.twig' with {id: 'export'} %}
<button type="submit" class="pa-buton-secundar">{{ t('admin.abonati.export') }}</button></form>
{% else %}<p class="pa-gol">{{ t('admin.abonati.gol') }}</p>{% endif %}

<h2 id="pa-ab-oferta">{{ t('admin.abonati.oferta_titlu') }}</h2>
{% if fara_smtp %}<p class="pa-avertizare" data-abonati-smtp>{{ t('admin.abonati.smtp', {n: pe_ora}) }} <a href="{{ url.emailuri }}">{{ t('admin.abonati.smtp_link') }}</a></p>{% endif %}
<p>{{ t('admin.abonati.oferta_explicatie', {n: pe_ora}) }}</p>
{% if in_curs %}<p class="pa-nota" data-abonati-in-curs>{{ t('admin.abonati.in_curs') }}</p>{% endif %}
<form method="post" action="{{ url.baza }}previzualizeaza" class="pa-formular"><input type="hidden" name="_csrf" value="{{ csrf }}">
<p><label for="pa-ab-subiect">{{ t('admin.abonati.subiect') }}</label><input id="pa-ab-subiect" name="subiect" type="text" maxlength="150" required value="{{ scris.subiect }}"{% if erori_camp.subiect is defined %} aria-invalid="true" aria-describedby="pa-ab-subiect-eroare"{% endif %}>
{% if erori_camp.subiect is defined %}<span class="pa-eroare-camp" id="pa-ab-subiect-eroare">{{ erori_camp.subiect }}</span>{% endif %}</p>
<p><label for="pa-ab-text">{{ t('admin.abonati.text') }}</label><span class="pa-ajutor" id="pa-ab-text-ajutor">{{ t('admin.abonati.text_ajutor') }}</span><textarea id="pa-ab-text" name="text" rows="12" required aria-describedby="pa-ab-text-ajutor{% if erori_camp.text is defined %} pa-ab-text-eroare{% endif %}"{% if erori_camp.text is defined %} aria-invalid="true"{% endif %}>{{ scris.text }}</textarea>
{% if erori_camp.text is defined %}<span class="pa-eroare-camp" id="pa-ab-text-eroare">{{ erori_camp.text }}</span>{% endif %}</p>
{% if eroare_la == 'oferta' %}<p class="pa-eroare-camp" role="alert">{{ eroare }}</p>{% endif %}
<p class="pa-actiuni"><button type="submit" class="pa-buton-secundar">{{ t('admin.abonati.previzualizeaza') }}</button>
<button type="submit" class="pa-buton-secundar" formaction="{{ url.baza }}proba">{{ t('admin.abonati.proba', {email: utilizator.email}) }}</button></p>
{% if previzualizare %}
<section class="pa-previzualizare" aria-labelledby="pa-ab-prev-titlu" data-abonati-previzualizare>
<h3 id="pa-ab-prev-titlu">{{ t('admin.abonati.previzualizare_titlu') }}</h3>
<p><strong>{{ t('admin.abonati.subiect') }}:</strong> {{ previzualizare.subiect }}</p>
<p>{{ previzualizare.salut }}</p>
{% for p in previzualizare.paragrafe %}<p>{{ p }}</p>{% endfor %}
{% if previzualizare.contact %}<p>{{ previzualizare.contact }}</p>{% endif %}
<p>{{ previzualizare.semnatura }}</p>
<p class="pa-ajutor">{{ previzualizare.subsol.text }} {{ previzualizare.subsol.link }}</p>
</section>
{% endif %}
<h3>{{ t('admin.abonati.trimite_titlu') }}</h3>
{% if numar %}
<p><input type="checkbox" id="pa-ab-confirm" name="confirm" value="1"><label for="pa-ab-confirm">{{ t('admin.abonati.confirm', {n: numar}) }}</label></p>
{% if eroare_la == 'trimite' %}<p class="pa-eroare-camp" role="alert">{{ eroare }}</p>{% endif %}
{% if not reautentificat %}<p><label for="pa-reauth-trimite">{{ t('admin.reauth.parola') }}</label><span class="pa-ajutor" id="pa-reauth-trimite-ajutor">{{ t('admin.abonati.parola_ajutor') }}</span><input id="pa-reauth-trimite" name="parola_reauth" type="password" autocomplete="current-password" aria-describedby="pa-reauth-trimite-ajutor"></p>{% endif %}
<p><button type="submit" class="pa-buton" formaction="{{ url.baza }}trimite"{% if in_curs %} disabled{% endif %}>{{ t('admin.abonati.trimite', {n: numar}) }}</button></p>
{% else %}<p class="pa-gol">{{ t('admin.abonati.trimite_gol') }}</p>{% endif %}
</form>

<h2 id="pa-ab-jurnal">{{ t('admin.abonati.jurnal_titlu') }}</h2>
{% if jurnal %}
<div class="pa-tabel"><table>
<thead><tr><th scope="col">{{ t('admin.abonati.col.la') }}</th><th scope="col">{{ t('admin.abonati.subiect') }}</th><th scope="col">{{ t('admin.abonati.col.destinatari') }}</th><th scope="col">{{ t('admin.abonati.col.trimise') }}</th><th scope="col">{{ t('admin.abonati.col.esuate') }}</th><th scope="col">{{ t('admin.abonati.col.in_coada') }}</th></tr></thead>
<tbody>{% for x in jurnal %}<tr data-trimitere><td data-eticheta="{{ t('admin.abonati.col.la') }}">{{ x.la }}</td><th scope="row" data-eticheta="{{ t('admin.abonati.subiect') }}">{{ x.subiect }}</th><td data-eticheta="{{ t('admin.abonati.col.destinatari') }}">{{ x.destinatari }}</td><td data-eticheta="{{ t('admin.abonati.col.trimise') }}">{{ x.trimise }}</td><td data-eticheta="{{ t('admin.abonati.col.esuate') }}">{{ x.esuate }}</td><td data-eticheta="{{ t('admin.abonati.col.in_coada') }}">{{ x.in_coada }}</td></tr>{% endfor %}</tbody>
</table></div>
{% else %}<p class="pa-gol">{{ t('admin.abonati.jurnal_gol') }}</p>{% endif %}
<p class="pa-ajutor">{{ t('admin.abonati.gdpr') }} <a href="{{ url.gdpr }}">{{ t('admin.nav.gdpr') }}</a></p>
{% endblock %}
