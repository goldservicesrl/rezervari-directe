{#- E-mailul nucleului, HTML: un layout simplu, lizibil în orice client, cu accentul temei. -#}
<!doctype html>
<html lang="{{ limba }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subiect }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f2;color:#1a1a1a;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.5">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f2"><tr><td align="center" style="padding:24px 12px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-top:6px solid {{ accent }}">
<tr><td style="padding:24px">
{% if nume %}<p style="margin:0 0 16px;font-size:20px;font-weight:bold">{{ nume }}</p>{% endif %}
{% if segmente is defined and segmente %}{% for s in segmente %}{% if s.tip == 'p' %}<p style="margin:0 0 16px">{% for l in s.linii %}{{ l }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
{% elseif s.tip == 'titlu' %}<p style="margin:0 0 8px;font-weight:bold">{{ s.text }}</p>
{% elseif s.tip == 'detalii' %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;border-collapse:collapse">
{% for d in s.randuri %}<tr><td style="padding:6px 8px 6px 0;border-bottom:1px solid #dddddd;font-weight:bold;vertical-align:top">{{ d[0] }}</td><td style="padding:6px 0;border-bottom:1px solid #dddddd">{{ d[1] }}</td></tr>{% endfor %}
</table>
{% endif %}{% endfor %}{% else %}<p style="margin:0 0 16px">{{ salut }}</p>
{% for p in paragrafe %}<p style="margin:0 0 16px">{{ p }}</p>{% endfor %}
{% if cod %}<p style="margin:0 0 16px;font-size:32px;font-weight:bold;letter-spacing:6px">{{ cod }}</p>{% endif %}
{% if detalii %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;border-collapse:collapse">
{% for d in detalii %}<tr><td style="padding:6px 8px 6px 0;border-bottom:1px solid #dddddd;font-weight:bold;vertical-align:top">{{ d[0] }}</td><td style="padding:6px 0;border-bottom:1px solid #dddddd">{{ d[1] }}</td></tr>{% endfor %}
</table>
{% endif %}
{% for x in sectiuni %}<p style="margin:0 0 8px;font-weight:bold">{{ x.titlu }}</p>
{% for p in x.paragrafe %}<p style="margin:0 0 12px">{{ p }}</p>{% endfor %}
{% endfor %}{% endif %}{% for b in butoane %}<p style="margin:0 0 16px"><a href="{{ b.url }}" style="display:inline-block;padding:12px 20px;background:{{ accent }};color:#ffffff;text-decoration:none;font-weight:bold;border-radius:4px">{{ b.text }}</a></p>{% endfor %}
{% if contact %}<p style="margin:0 0 16px">{{ contact }}</p>{% endif %}
{% if nota_gazda is defined and nota_gazda %}<div style="margin:0 0 16px;padding:12px 16px;border-left:4px solid {{ accent }};background:#f7f7f5"><p style="margin:0 0 8px;font-weight:bold">{{ nota_titlu }}</p><p style="margin:0">{{ nota_gazda }}</p></div>{% endif %}
{% if semnatura %}<p style="margin:0">{{ semnatura }}</p>{% endif %}
{% if subsol is defined and subsol %}<p style="margin:24px 0 0;padding-top:12px;border-top:1px solid #dddddd;font-size:13px;color:#555555">{{ subsol.text }} <a href="{{ subsol.url }}" style="color:#555555">{{ subsol.link }}</a></p>{% endif %}
</td></tr>
</table>
</td></tr></table>
</body>
</html>
