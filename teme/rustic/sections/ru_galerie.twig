{#- Galeria: pozele de după cea principală (galerie.grila, o poză pe categorie; până atunci pozele
    proprietății), toate decupate la același raport (object-fit: cover), deci pozele în picioare și cele late stau la
    fel. Se arată 5, 3 sau 1-2 poze, ca grila să rămână plină: pe ecran lat, prima ocupă două rânduri. Legenda e
    eticheta categoriei. Restul fotografiilor, grupate pe categorii (galerie.grupe), într-un <details>, fără
    JavaScript; fiecare se deschide întreagă la clic. Fără poze în afara celei principale, secțiunea lipsește. -#}
{% set toate = proprietate.poze %}
{% set sursa = galerie.grila ?? toate|slice(1, 5) %}
{% set n = sursa|length >= 5 ? 5 : (sursa|length >= 3 ? 3 : sursa|length) %}
{% set grila = sursa|slice(0, n) %}
{% set numar = galerie.numar ?? toate|length %}
{% if grila|length > 0 %}
<section class="ru-banda ru-galerie-sectiune" aria-labelledby="{{ sectiune.id }}-t">
<div class="ru-latime">
<div class="ru-cap">
<p class="ru-semn">{% include "partials/numar.twig" with {n: numar, cheie: 'galerie.numar'} only %}</p>
<h2 id="{{ sectiune.id }}-t">{{ t('galerie.titlu') }}</h2>
</div>
<ul class="ru-galerie ru-galerie-{{ n }}">
{% for p in grila %}<li><figure>{{ img(p, loop.first ? [960, 1440] : [480, 960], false, loop.first ? '(min-width: 56rem) 36rem, 100vw' : '(min-width: 56rem) 18rem, 50vw', true) }}{% if p.legenda ?? '' %}<figcaption>{{ p.legenda }}</figcaption>{% endif %}</figure></li>{% endfor %}
</ul>
{% if numar > n + 1 %}
<details class="ru-toate">
<summary>{{ t('galerie.toate', {n: numar}) }}</summary>
{% if galerie.grupe ?? false %}
{% for gr in galerie.grupe %}{% if gr.eticheta ?? '' %}<h3>{{ gr.eticheta }}</h3>{% endif %}
<ul class="ru-toate-lista">{% for p in gr.poze %}<li>{{ img(p, [480, 960], false, '(min-width: 56rem) 14rem, 50vw', true) }}</li>{% endfor %}</ul>{% endfor %}
{% else %}
<ul class="ru-toate-lista">{% for p in toate %}<li>{{ img(p, [480, 960], false, '(min-width: 56rem) 14rem, 50vw', true) }}</li>{% endfor %}</ul>
{% endif %}
</details>
{% endif %}
</div>
</section>
{% endif %}
