<section class="sc-sectiune sc-hero sc-hero--{{ sectiune.setari.varianta }}" aria-labelledby="{{ sectiune.id }}-titlu">
{% if sectiune.setari.cu_poza and proprietate.poze|length > 0 %}<div class="sc-hero-poza">{{ img(proprietate.poze|first, [960, 1440, 2048], true, '100vw') }}</div>{% endif %}
<div class="sc-latime sc-hero-text">
<h1 id="{{ sectiune.id }}-titlu">{{ proprietate.nume }}</h1>
{% if sectiune.setari.subtitlu %}<p class="sc-hero-subtitlu">{{ t(sectiune.setari.subtitlu, {localitate: proprietate.adresa.localitate}) }}</p>{% endif %}
{{ cazo.bara_rezervare() }}
</div>
</section>
