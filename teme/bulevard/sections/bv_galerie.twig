{#- Fotografiile: grila de cel mult 5 (câte una pe categorie, galerie.grila; altfel pozele de după cea principală),
    cu legenda generică a categoriei (poza.legenda), apoi toate fotografiile, grupate pe categorii (galerie.grupe),
    într-un <details> care merge fără JavaScript. Cu mai puține poze, grila se strânge; cu una singură, secțiunea lipsește. -#}
{% set toate = proprietate.poze %}
{% set grila = galerie.grila ?? toate|slice(1, 5) %}
{% set numar = galerie.numar ?? toate|length %}
{% if grila|length > 0 %}
<section class="bv-card bv-galerie" aria-labelledby="{{ sectiune.id }}-t">
<div class="bv-sectiune-cap">
<h2 id="{{ sectiune.id }}-t">{{ t('galerie.titlu') }}</h2>
</div>
<ul class="bv-galerie-grila bv-galerie-{{ grila|length }}">
{% for p in grila|slice(0, 5) %}<li class="bv-gal-{{ loop.index }}"><figure>{{ img(p, loop.first ? [960, 1440] : [480, 960], false, loop.first ? '(min-width: 45rem) 26rem, 100vw' : '(min-width: 45rem) 13rem, 50vw', true) }}{% if p.legenda ?? '' %}<figcaption>{{ p.legenda }}</figcaption>{% endif %}</figure></li>{% endfor %}
</ul>
{% if numar > grila|length + 1 %}
<details class="bv-galerie-toate">
<summary>{{ t('galerie.toate', {n: numar}) }}</summary>
{% if galerie.grupe ?? false %}
{% for gr in galerie.grupe %}{% if gr.eticheta %}<h3>{{ gr.eticheta }}</h3>{% endif %}
<ul class="bv-galerie-lista">{% for p in gr.poze %}<li>{{ img(p, [480, 960], false, '(min-width: 45rem) 13rem, 50vw', true) }}</li>{% endfor %}</ul>{% endfor %}
{% else %}
<ul class="bv-galerie-lista">{% for p in toate %}<li><figure>{{ img(p, [480, 960], false, '(min-width: 45rem) 13rem, 50vw', true) }}{% if p.legenda ?? '' %}<figcaption>{{ p.legenda }}</figcaption>{% endif %}</figure></li>{% endfor %}</ul>
{% endif %}
</details>
{% endif %}
</section>
{% endif %}
