{#- Antetul: monograma din inițiala numelui (AUTO), numele, meniul nucleului, limbile și îndemnul spre camere. -#}
{%- set sg = site.sigla ?? null -%}
<header class="bv-antet">
<a class="bv-sigla" href="{{ site.url_baza }}">{% if sg %}<img class="pg-sigla-img" src="{{ sg.url }}" alt="{{ sg.cu_nume ? '' : site.nume }}" width="{{ sg.latime }}" height="{{ sg.inaltime }}">{% else %}<span class="bv-sigla-semn" aria-hidden="true">{{ site.nume|first|upper }}</span>{% endif %}{% if not sg or sg.cu_nume %}<span class="bv-sigla-nume">{{ site.nume }}</span>{% endif %}</a>
<nav class="bv-meniu" aria-label="{{ t('meniu.principal') }}">
<ul>{% for m in meniu.principal %}<li><a href="{{ m.url }}"{% if m.activ %} aria-current="page"{% endif %}>{{ m.titlu }}</a></li>{% endfor %}</ul>
</nav>
<a class="bv-buton bv-buton-plin" href="{{ camere|length == 1 ? (camere|first).url : url('camere') }}">{{ t('antet.rezervati') }}</a>
{% if site.limbi|length > 1 %}<nav class="bv-limbi" aria-label="{{ t('meniu.limba') }}"><ul>{% for l in site.limbi %}<li><a href="{{ l.url }}" hreflang="{{ l.cod }}" lang="{{ l.cod }}" title="{{ l.nume }}"{% if l.activa %} aria-current="true"{% endif %}>{{ l.cod|upper }}</a></li>{% endfor %}</ul></nav>{% endif %}
</header>
