<html lang="{{ site.limba }}">
<head>
{{ cazo.head() }}
</head>
<body class="po-corp">
<a class="po-salt" href="#continut">{{ t('salt_continut') }}</a>
{% include "partials/antet.twig" %}
<main id="continut" class="po-principal">
{% block continut %}{% endblock %}
</main>
{{ cazo.foot() }}
</body>
</html>
